{
    "name": "Gentle Handling Development",
    "workspaceFolder": "/gentle_handling",
    "workspaceMount": "src=${localWorkspaceFolder},dst=/gentle_handling,type=bind,consistency=cached",
    "dockerFile": "Dockerfile",
    
    "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3"
    },
    
    "remoteUser": "vscode",
    
    "runArgs": [
        // Debugging support
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined",
        
        // SSH access
        "-v", "${env:HOME}${env:USERPROFILE}/.ssh:/home/vscode/.ssh",
        
        // Media access
        "-v", "/media:/media",
        
        // Graphics support
        "--env=DISPLAY",
        "--volume=${env:HOME}/.Xauthority:/home/vscode/.Xauthority:rw",
        "--privileged",
        
        // Serial
        "--device=/dev/ttyACM0:/dev/ttyACM0",
        "--group-add=dialout",
        "--privileged",
        
        // Network
        "--net=host",
        
        // GPU support
        "--gpus=all",
        "-e", "NVIDIA_VISIBLE_DEVICES=all",
        "-e", "NVIDIA_DRIVER_CAPABILITIES=compute,utility,video,display",
        
        // System limits
        "--ulimit", "core=0",
        
        // Video devices
        "--device=/dev/video*:/dev/video*",
        "--device=/dev/dri:/dev/dri",
        "--group-add=video"
    ],
    
    "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "eamodio.gitlens",
        "twxs.cmake",
        "mhutchie.git-graph",
        "ms-iot.vscode-ros"
    ],
    
    // "postCreateCommand": "echo 'Gentle Handling container ready! Use vcs to import your repos.'"
    "postCreateCommand": "mkdir -p ws/src && echo 'Gentle Handling container ready! Project workspace: /gentle_handling/ws'"
}